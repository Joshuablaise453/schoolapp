<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/glassy_item_bg"
    android:stateListAnimator="@animator/item_bounce_animator"
    android:elevation="4dp">

    <View
        android:id="@+id/activeBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nav_pill_bg"
        android:backgroundTint="#40FFFFFF"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/itemIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="24dp"
        android:src="@android:drawable/ic_menu_today"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/itemText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="20dp"
        android:layout_toEndOf="@id/itemIcon"
        android:text="Menu Item"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/activeIndicator"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:src="@android:drawable/btn_radio"
        app:tint="@color/white"
        android:visibility="gone" />

</RelativeLayout>